:root {
    --btn-color: rgb(50, 50, 50);
    --btn-color-hover: rgb(255, 255, 255);
    --btn-txt-color: rgb(255, 255, 255);
    --btn-txt-color-hover: rgb(100, 100, 100);
    --txt-color: rgb(59, 59, 59);
    --logo-color: rgb(80, 80, 80);
}

.container-menu {
    align-self: stretch;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-content: center;
}

.container-button-vertical {
    justify-content: space-evenly;
    align-self: stretch;
    align-content: center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-size: 100% 100%;
}

.container-logo {
    justify-content: space-evenly;
    align-self: stretch;
    align-content: flex-end;
    padding-top: 0;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 0;
    background-size: 100% 100%;
    position: absolute;
    right: 0;
    bottom: 0;
    margin-top: 0;
    width: auto;
    height: 12%;
    flex-direction: row-reverse;
    align-items: stretch;
}

.menu-container-pop {
    flex-grow: 1;
    justify-content: space-around;
    align-items: center;
    align-content: center;
    align-self: center;
    width: 80%;
    height: 80%;
    position: absolute;
    top: 10%;
    bottom: 10%;
}

.image-background {
    height: 100%;
    width: 100%;
    background-color: rgb(149, 149, 149);
}

.text-version {
    position: absolute;
    bottom: 0;
    -unity-text-align: lower-left;
    padding-right: 0%;
    padding-left: 0%;
    margin-top: 0;
    margin-right: 8px;
    margin-bottom: 0;
    margin-left: 8px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/rocks-serif/gomarice_rocks_serif.ttf?fileID=12800000&guid=fbc97c39081110c4fbb781eb4f13a1b6&type=3#gomarice_rocks_serif");
    padding-top: 0%;
    padding-bottom: 0%;
    left: 0;
    right: auto;
    top: auto;
    white-space: nowrap;
    align-self: flex-start;
    align-content: flex-end;
    color: var(--txt-color);
}

.text-title {
    font-size: 96px;
    -unity-text-align: lower-center;
    text-overflow: clip;
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 10px;
    padding-bottom: 0;
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/rocks-serif/gomarice_rocks_serif.ttf?fileID=12800000&guid=fbc97c39081110c4fbb781eb4f13a1b6&type=3#gomarice_rocks_serif");
    width: 100%;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 124px;
    color: var(--txt-color);
    -unity-font-style: normal;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--txt-color);
    text-shadow: 0 10px 5px rgba(0, 0, 0, 0.39);
    letter-spacing: -5px;
    height: auto;
}

.button-text {
    background-color: rgba(188, 188, 188, 0);
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/rocks-serif/gomarice_rocks_serif.ttf?fileID=12800000&guid=fbc97c39081110c4fbb781eb4f13a1b6&type=3#gomarice_rocks_serif");
    font-size: 32px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-right: 10px;
    padding-left: 10px;
    flex-wrap: nowrap;
    text-overflow: ellipsis;
    -unity-background-scale-mode: stretch-to-fill;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-size: contain;
}

.button-text:hover {
    scale: 1.1 1.1;
}

.button-text:active {
    scale: 0.9;
}

.button-hexagon {
    background-color: rgba(0, 0, 0, 0);
    color: var(--btn-txt-color);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/rocks-serif/gomarice_rocks_serif.ttf?fileID=12800000&guid=fbc97c39081110c4fbb781eb4f13a1b6&type=3#gomarice_rocks_serif");
    font-size: 32px;
    margin-top: 10px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-right: 10px;
    padding-left: 10px;
    flex-wrap: nowrap;
    text-overflow: ellipsis;
    -unity-background-scale-mode: stretch-to-fill;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-size: 90% 150%;
    width: auto;
    max-width: none;
    align-self: center;
    min-width: 300px;
    background-image: url("project://database/Assets/UI/Images/Hexagon.png?fileID=2800000&guid=50485551a5f1be24394f84593f64a179&type=3#Hexagon");
    -unity-background-image-tint-color: var(--btn-color);
    padding-top: 3px;
    padding-bottom: 3px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 32px;
}

.button-hexagon:hover {
    scale: 1.3 1.1;
    background-image: url("project://database/Assets/UI/Images/Hexagon.png?fileID=2800000&guid=50485551a5f1be24394f84593f64a179&type=3#Hexagon");
    color: var(--btn-txt-color-hover);
    -unity-background-image-tint-color: var(--btn-color-hover);
}

.logo {
    aspect-ratio: 1;
    height: 100%;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    -unity-background-image-tint-color: var(--logo-color);
}
