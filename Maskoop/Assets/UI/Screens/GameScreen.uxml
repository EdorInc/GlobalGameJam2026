<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="LoseTemplate" src="project://database/Assets/UI/Templates/LoseTemplate.uxml?fileID=9197481963319205126&amp;guid=642c947003927604e83bfdfc1633753a&amp;type=3#LoseTemplate"/>
    <ui:Template name="PauseTemplate" src="project://database/Assets/UI/Templates/PauseTemplate.uxml?fileID=9197481963319205126&amp;guid=55ff63d6ceb378e4a8630c51a6cacf60&amp;type=3#PauseTemplate"/>
    <ui:Template name="VideoTutorialTemplate" src="project://database/Assets/UI/Templates/VideoTutorialTemplate.uxml?fileID=9197481963319205126&amp;guid=8800d422e4c4be14b80594a2b6b21954&amp;type=3#VideoTutorialTemplate"/>
    <ui:Template name="WinTemplate" src="project://database/Assets/UI/Templates/WinTemplate.uxml?fileID=9197481963319205126&amp;guid=5d41eb22aeb63304c9041e72575b2e42&amp;type=3#WinTemplate"/>
    <Style src="project://database/Assets/UI/Themes/DefaultTheme.uss?fileID=7433441132597879392&amp;guid=abd6d9976d619a646a1faab02692b347&amp;type=3#DefaultTheme"/>
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="game-ui" style="flex-grow: 1; width: 100%; height: 100%;">
            <ui:VisualElement name="separator" style="flex-grow: 1; background-color: rgb(255, 255, 255); width: 8px; height: 100%; position: absolute; left: 50%; right: 50%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-color: rgba(0, 0, 0, 0); border-right-color: rgb(102, 102, 102); border-bottom-color: rgba(0, 0, 0, 0); border-left-color: rgb(102, 102, 102);"/>
            <ui:VisualElement name="frame" style="flex-grow: 1; position: absolute; top: 0; background-color: rgb(51, 51, 51); width: 30%; height: 50px; left: 35%; right: auto; flex-direction: row; align-self: center;">
                <ui:VisualElement name="timer-container" style="flex-grow: 0; width: 100%; right: 0; height: 100%; flex-shrink: 1; flex-direction: row; align-content: flex-start; justify-content: flex-start;">
                    <ui:Image name="menu-icon" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images/Menu.png?fileID=2800000&amp;guid=d68d99c36efa7b84b8f80a7406e96d09&amp;type=3#Menu&quot;); -unity-background-image-tint-color: rgb(153, 153, 153); padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; aspect-ratio: 1; flex-grow: 0; flex-shrink: 0; background-color: rgb(77, 77, 77); background-size: 80% 80%;"/>
                    <ui:Label text="000" name="timer-label" style="flex-grow: 1; -unity-text-generator: advanced; -unity-text-auto-size: none; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/rocks-serif/gomarice_rocks_serif.ttf?fileID=12800000&amp;guid=fbc97c39081110c4fbb781eb4f13a1b6&amp;type=3#gomarice_rocks_serif&quot;); color: rgb(153, 153, 153); -unity-text-align: upper-center; font-size: 40px; padding-right: 0; padding-left: 0; margin-left: 0; margin-right: 0; margin-bottom: 4px; flex-shrink: 1; width: auto; height: auto;"/>
                    <ui:Image name="menu-icon" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images/Timer.png?fileID=2800000&amp;guid=e7829cd313f3b2d448723dbfe2cc2d0f&amp;type=3#Timer&quot;); -unity-background-image-tint-color: rgb(153, 153, 153); padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; aspect-ratio: 1; flex-grow: 0; flex-shrink: 0; background-color: rgba(77, 77, 77, 0); background-size: 80% 80%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="VideoTutorialTemplate" name="tutorial-ui"/>
        <ui:Instance template="WinTemplate" name="win-ui" style="width: 100%; height: 100%; display: none; position: absolute;"/>
        <ui:Instance template="PauseTemplate" name="pause-ui" style="height: 100%; width: 100%; display: none; position: absolute;"/>
        <ui:Instance template="LoseTemplate" name="lose-ui" style="width: 100%; height: 100%; display: none; position: absolute;"/>
    </ui:VisualElement>
</ui:UXML>
